---
interface Props {
  title: string;
  description: string;
  icon?: string;
  href: string;
}

const { title, description, icon, href } = Astro.props;
---
<a href={href} class="service-card">
  {icon && <div class="icon-wrapper"><span class="icon">{icon}</span></div>}
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="learn-more">Learn More &rarr;</span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 32px;
    text-decoration: none;
    color: inherit;
    transition: all 200ms ease;
    box-shadow: 0 4px 16px -2px rgba(11, 34, 51, 0.05);
  }

  .service-card:hover {
    border-color: var(--color-bright-blue);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px -4px rgba(0, 68, 102, 0.12);
  }

  .icon-wrapper {
    color: var(--color-cyan);
    font-size: 32px;
    margin-bottom: 24px;
  }

  h3 {
    margin: 0 0 16px 0;
    font-size: 22px;
  }

  p {
    color: var(--color-muted-text);
    margin: 0 0 24px 0;
    flex-grow: 1;
    line-height: 1.6;
  }

  .learn-more {
    color: var(--color-bright-blue);
    font-weight: 600;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    transition: transform 200ms ease;
  }

  .service-card:hover .learn-more {
    transform: translateX(4px);
  }
</style>
