---
import Layout from '../layouts/Layout.astro';
import PrimaryButton from '../components/ui/PrimaryButton.astro';
---

<Layout title="Start a Project | Akash Software Limited" description="Tell us about your project. Share your goals, timeline, and budget — and we'll get back to you with a tailored proposal.">
  <!-- Hero Section — distinct gradient treatment, not the same flat navy as Contact -->
  <div class="project-hero">
    <div class="container">
      <span class="eyebrow">START A PROJECT</span>
      <h1>Let's Turn Your Vision Into Reality.</h1>
      <p class="hero-subtitle">Walk us through your project details below. The more context you share, the better we can tailor our proposal to your needs.</p>
      <div class="hero-stats">
        <div class="stat">
          <strong>200+</strong>
          <span>Projects Delivered</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <strong>50+</strong>
          <span>Happy Clients</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <strong>48hr</strong>
          <span>Avg. Response Time</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Progress Indicator -->
  <div class="progress-bar-container">
    <div class="container">
      <div class="progress-steps">
        <div class="step active" data-step="1">
          <div class="step-number">1</div>
          <span>Project Details</span>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="2">
          <div class="step-number">2</div>
          <span>Scope &amp; Budget</span>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="3">
          <div class="step-number">3</div>
          <span>Your Info</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Section -->
  <section class="project-form-section">
    <div class="container">
      <form id="project-inquiry-form" novalidate>

        <!-- STEP 1: Project Details -->
        <div class="form-step active" data-form-step="1">
          <!-- Service Selection Cards -->
          <div class="form-block">
            <h2>What type of project are you looking for?</h2>
            <p class="form-block-desc">Select all services that apply to your project.</p>
            <div class="service-cards" role="group" aria-label="Project type selection">
              <label class="service-card" for="svc-web">
                <input type="checkbox" id="svc-web" name="services" value="Web Application Development" />
                <div class="card-inner">
                  <span class="card-icon">💻</span>
                  <strong>Web Application</strong>
                  <span class="card-desc">React, Next.js, Vue, Astro</span>
                </div>
                <span class="check-indicator" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 9.5L7.5 13L14 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </label>

              <label class="service-card" for="svc-mobile">
                <input type="checkbox" id="svc-mobile" name="services" value="Mobile App Development" />
                <div class="card-inner">
                  <span class="card-icon">📱</span>
                  <strong>Mobile App</strong>
                  <span class="card-desc">Flutter, React Native, Native</span>
                </div>
                <span class="check-indicator" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 9.5L7.5 13L14 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </label>

              <label class="service-card" for="svc-backend">
                <input type="checkbox" id="svc-backend" name="services" value="Backend & API Development" />
                <div class="card-inner">
                  <span class="card-icon">⚙️</span>
                  <strong>Backend &amp; API</strong>
                  <span class="card-desc">Node.js, Python, Go, .NET</span>
                </div>
                <span class="check-indicator" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 9.5L7.5 13L14 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </label>

              <label class="service-card" for="svc-uiux">
                <input type="checkbox" id="svc-uiux" name="services" value="UI/UX Design" />
                <div class="card-inner">
                  <span class="card-icon">🎨</span>
                  <strong>UI/UX Design</strong>
                  <span class="card-desc">Figma, Prototyping, Research</span>
                </div>
                <span class="check-indicator" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 9.5L7.5 13L14 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </label>

              <label class="service-card" for="svc-cloud">
                <input type="checkbox" id="svc-cloud" name="services" value="Cloud Solutions" />
                <div class="card-inner">
                  <span class="card-icon">☁️</span>
                  <strong>Cloud Solutions</strong>
                  <span class="card-desc">AWS, GCP, Azure, Docker</span>
                </div>
                <span class="check-indicator" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 9.5L7.5 13L14 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </label>

              <label class="service-card" for="svc-qa">
                <input type="checkbox" id="svc-qa" name="services" value="QA & Testing" />
                <div class="card-inner">
                  <span class="card-icon">🧪</span>
                  <strong>QA &amp; Testing</strong>
                  <span class="card-desc">Jest, Cypress, Selenium</span>
                </div>
                <span class="check-indicator" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 9.5L7.5 13L14 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </label>
            </div>
            <div class="field-error" id="services-error" role="alert"></div>
          </div>

          <!-- Project Goals -->
          <div class="form-block">
            <h2>Tell us about your project</h2>
            <p class="form-block-desc">What problem are you solving, or what opportunity are you pursuing?</p>

            <div class="form-group">
              <label for="project-name">Project Name <span class="optional">(optional)</span></label>
              <input type="text" id="project-name" name="projectName" placeholder="e.g. Customer Portal Redesign" />
            </div>

            <div class="form-group">
              <label for="project-goals">Project Goals &amp; Requirements <span class="required-mark" aria-label="required">*</span></label>
              <textarea id="project-goals" name="projectGoals" rows="5" required placeholder="Describe your project goals, key features, target audience, and any specific requirements..."></textarea>
              <span class="char-count"><span id="goals-count">0</span> / 2000</span>
              <div class="field-error" id="goals-error" role="alert"></div>
            </div>

            <div class="form-group">
              <label for="existing-systems">Existing Systems or Integrations <span class="optional">(optional)</span></label>
              <input type="text" id="existing-systems" name="existingSystems" placeholder="e.g. Salesforce CRM, Stripe, PostgreSQL database" />
            </div>
          </div>

          <div class="form-actions">
            <button type="button" class="btn-next" id="btn-next-1">
              Continue to Scope &amp; Budget
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4L13.5 10L7.5 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>

        <!-- STEP 2: Scope & Budget -->
        <div class="form-step" data-form-step="2">
          <div class="form-block">
            <h2>Scope &amp; Budget</h2>
            <p class="form-block-desc">This helps us match the right team and approach to your project.</p>

            <div class="form-row">
              <div class="form-group">
                <label for="budget-range">Estimated Budget <span class="required-mark" aria-label="required">*</span></label>
                <select id="budget-range" name="budgetRange" required>
                  <option value="" disabled selected>Select a range</option>
                  <option value="under-10k">Under $10,000</option>
                  <option value="10k-25k">$10,000 – $25,000</option>
                  <option value="25k-50k">$25,000 – $50,000</option>
                  <option value="50k-100k">$50,000 – $100,000</option>
                  <option value="100k-plus">$100,000+</option>
                  <option value="not-sure">Not sure yet</option>
                </select>
                <div class="field-error" id="budget-error" role="alert"></div>
              </div>

              <div class="form-group">
                <label for="timeline">Expected Timeline <span class="required-mark" aria-label="required">*</span></label>
                <select id="timeline" name="timeline" required>
                  <option value="" disabled selected>Select a timeline</option>
                  <option value="asap">ASAP – Urgent</option>
                  <option value="1-3-months">1 – 3 months</option>
                  <option value="3-6-months">3 – 6 months</option>
                  <option value="6-plus-months">6+ months</option>
                  <option value="flexible">Flexible / No fixed deadline</option>
                </select>
                <div class="field-error" id="timeline-error" role="alert"></div>
              </div>
            </div>

            <div class="form-group">
              <label>Project Stage</label>
              <div class="radio-group" role="radiogroup" aria-label="Project stage">
                <label class="radio-option" for="stage-idea">
                  <input type="radio" id="stage-idea" name="projectStage" value="idea" />
                  <span class="radio-label">
                    <strong>Idea Stage</strong>
                    <span>I have a concept but haven't started</span>
                  </span>
                </label>
                <label class="radio-option" for="stage-design">
                  <input type="radio" id="stage-design" name="projectStage" value="design-ready" />
                  <span class="radio-label">
                    <strong>Design Ready</strong>
                    <span>I have wireframes or designs</span>
                  </span>
                </label>
                <label class="radio-option" for="stage-existing">
                  <input type="radio" id="stage-existing" name="projectStage" value="existing-product" />
                  <span class="radio-label">
                    <strong>Existing Product</strong>
                    <span>I need upgrades or new features</span>
                  </span>
                </label>
                <label class="radio-option" for="stage-migration">
                  <input type="radio" id="stage-migration" name="projectStage" value="migration" />
                  <span class="radio-label">
                    <strong>Migration / Rebuild</strong>
                    <span>Re-platforming or modernizing</span>
                  </span>
                </label>
              </div>
            </div>
          </div>

          <div class="form-actions form-actions-between">
            <button type="button" class="btn-back" id="btn-back-2">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 16L6.5 10L12.5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Back
            </button>
            <button type="button" class="btn-next" id="btn-next-2">
              Continue to Your Info
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4L13.5 10L7.5 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>

        <!-- STEP 3: Your Info -->
        <div class="form-step" data-form-step="3">
          <div class="form-block">
            <h2>Your Information</h2>
            <p class="form-block-desc">Let us know who we'll be working with.</p>

            <div class="form-row">
              <div class="form-group">
                <label for="contact-name">Full Name <span class="required-mark" aria-label="required">*</span></label>
                <input type="text" id="contact-name" name="contactName" required placeholder="Jane Doe" />
                <div class="field-error" id="name-error" role="alert"></div>
              </div>
              <div class="form-group">
                <label for="contact-email">Work Email <span class="required-mark" aria-label="required">*</span></label>
                <input type="email" id="contact-email" name="contactEmail" required placeholder="jane@company.com" />
                <div class="field-error" id="email-error" role="alert"></div>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="company-name">Company / Organization <span class="optional">(optional)</span></label>
                <input type="text" id="company-name" name="companyName" placeholder="Acme Corp" />
              </div>
              <div class="form-group">
                <label for="contact-phone">Phone Number <span class="optional">(optional)</span></label>
                <input type="tel" id="contact-phone" name="contactPhone" placeholder="+1 (555) 123-4567" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="company-role">Your Role <span class="optional">(optional)</span></label>
                <input type="text" id="company-role" name="companyRole" placeholder="CTO, Product Manager, Founder..." />
              </div>
              <div class="form-group">
                <label for="company-website">Company Website <span class="optional">(optional)</span></label>
                <input type="url" id="company-website" name="companyWebsite" placeholder="https://company.com" />
              </div>
            </div>

            <div class="form-group">
              <label for="how-found">How did you hear about us? <span class="optional">(optional)</span></label>
              <select id="how-found" name="howFound">
                <option value="" disabled selected>Select an option</option>
                <option value="google">Google Search</option>
                <option value="referral">Referral</option>
                <option value="social">Social Media</option>
                <option value="portfolio">Saw our portfolio</option>
                <option value="event">Event / Conference</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="additional-notes">Additional Notes <span class="optional">(optional)</span></label>
              <textarea id="additional-notes" name="additionalNotes" rows="3" placeholder="Anything else you'd like us to know? Links to reference projects, specific technologies, NDAs..."></textarea>
            </div>

            <div class="nda-notice">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.333A6.667 6.667 0 1 0 14.667 8 6.667 6.667 0 0 0 8 1.333Zm0 3.334a.667.667 0 1 1 0 1.333.667.667 0 0 1 0-1.333ZM9.333 11.333H6.667v-.666h1V8H6.667v-.667h2v3.334h.666v.666Z" fill="currentColor"/></svg>
              <span>All information is treated confidentially. We're happy to sign an NDA before discussing your project in detail.</span>
            </div>
          </div>

          <div class="form-actions form-actions-between">
            <button type="button" class="btn-back" id="btn-back-3">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 16L6.5 10L12.5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Back
            </button>
            <button type="submit" class="btn-submit" id="btn-submit">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.667 3.333 9.167 17.5l-1.834-6.333L1 9.333l15.667-6Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Submit Project Request
            </button>
          </div>
        </div>
      </form>

      <!-- Success State -->
      <div id="project-success" class="project-success" style="display: none;">
        <div class="success-icon" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="3"/><path d="M20 33L28 41L44 23" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h2>Your Project Request Has Been Submitted!</h2>
        <p class="success-lead">Thank you for choosing Akash Software Limited. Our team will review your project details and get back to you within <strong>2 business days</strong> with a tailored response.</p>
        <div class="success-next-steps">
          <h3>What Happens Next?</h3>
          <ol>
            <li><strong>Review</strong> — Our team reviews your requirements and identifies the best approach.</li>
            <li><strong>Discovery Call</strong> — We schedule a 30-minute call to discuss your project in detail.</li>
            <li><strong>Proposal</strong> — You receive a detailed proposal with scope, timeline, and pricing.</li>
          </ol>
        </div>
        <div class="success-actions">
          <PrimaryButton text="Back to Home" href="/" />
          <a href="/projects" class="btn-secondary-link">View Our Work →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust / Social Proof Strip -->
  <section class="trust-strip" id="trust-strip">
    <div class="container">
      <div class="trust-items">
        <div class="trust-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/></svg>
          <div>
            <strong>4.9/5 Client Rating</strong>
            <span>Based on 50+ project reviews</span>
          </div>
        </div>
        <div class="trust-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div>
            <strong>100% On-Time Delivery</strong>
            <span>We meet deadlines, every time</span>
          </div>
        </div>
        <div class="trust-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div>
            <strong>NDA Protected</strong>
            <span>Your ideas are always safe</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('project-inquiry-form') as HTMLFormElement;
    const successEl = document.getElementById('project-success') as HTMLElement;
    const trustStrip = document.getElementById('trust-strip') as HTMLElement;
    const steps = document.querySelectorAll<HTMLElement>('.form-step');
    const progressSteps = document.querySelectorAll<HTMLElement>('.progress-steps .step');
    const progressLines = document.querySelectorAll<HTMLElement>('.progress-steps .step-line');

    let currentStep = 1;

    // Character count for goals
    const goalsTextarea = document.getElementById('project-goals') as HTMLTextAreaElement;
    const goalsCount = document.getElementById('goals-count') as HTMLElement;
    goalsTextarea?.addEventListener('input', () => {
      const count = goalsTextarea.value.length;
      goalsCount.textContent = String(count);
      if (count > 2000) {
        goalsCount.parentElement!.classList.add('over-limit');
      } else {
        goalsCount.parentElement!.classList.remove('over-limit');
      }
    });

    function showStep(step: number) {
      steps.forEach(s => {
        s.classList.remove('active');
        if (Number(s.dataset.formStep) === step) {
          s.classList.add('active');
        }
      });

      progressSteps.forEach((ps, i) => {
        const stepNum = i + 1;
        ps.classList.remove('active', 'completed');
        if (stepNum === step) ps.classList.add('active');
        if (stepNum < step) ps.classList.add('completed');
      });

      progressLines.forEach((line, i) => {
        line.classList.remove('completed');
        if (i + 1 < step) line.classList.add('completed');
      });

      currentStep = step;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function clearError(id: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = '';
    }

    function setError(id: string, message: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = message;
    }

    // Validate Step 1
    function validateStep1(): boolean {
      let valid = true;
      clearError('services-error');
      clearError('goals-error');

      const checked = form.querySelectorAll<HTMLInputElement>('input[name="services"]:checked');
      if (checked.length === 0) {
        setError('services-error', 'Please select at least one project type.');
        valid = false;
      }

      const goals = (document.getElementById('project-goals') as HTMLTextAreaElement).value.trim();
      if (!goals) {
        setError('goals-error', 'Please describe your project goals and requirements.');
        valid = false;
      } else if (goals.length > 2000) {
        setError('goals-error', 'Please keep your description under 2000 characters.');
        valid = false;
      }

      return valid;
    }

    // Validate Step 2
    function validateStep2(): boolean {
      let valid = true;
      clearError('budget-error');
      clearError('timeline-error');

      const budget = (document.getElementById('budget-range') as HTMLSelectElement).value;
      if (!budget) {
        setError('budget-error', 'Please select a budget range.');
        valid = false;
      }

      const timeline = (document.getElementById('timeline') as HTMLSelectElement).value;
      if (!timeline) {
        setError('timeline-error', 'Please select an expected timeline.');
        valid = false;
      }

      return valid;
    }

    // Validate Step 3
    function validateStep3(): boolean {
      let valid = true;
      clearError('name-error');
      clearError('email-error');

      const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
      if (!name) {
        setError('name-error', 'Please enter your full name.');
        valid = false;
      }

      const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
      if (!email) {
        setError('email-error', 'Please enter your work email.');
        valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError('email-error', 'Please enter a valid email address.');
        valid = false;
      }

      return valid;
    }

    // Navigation
    document.getElementById('btn-next-1')?.addEventListener('click', () => {
      if (validateStep1()) showStep(2);
    });

    document.getElementById('btn-next-2')?.addEventListener('click', () => {
      if (validateStep2()) showStep(3);
    });

    document.getElementById('btn-back-2')?.addEventListener('click', () => showStep(1));
    document.getElementById('btn-back-3')?.addEventListener('click', () => showStep(2));

    // Submit
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validateStep3()) return;

      // Show success state
      form.style.display = 'none';
      document.querySelector('.progress-bar-container')?.classList.add('hidden');
      trustStrip.style.display = 'none';
      successEl.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Live clearing of errors on input
    form?.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      if (target.id === 'project-goals') clearError('goals-error');
      if (target.id === 'contact-name') clearError('name-error');
      if (target.id === 'contact-email') clearError('email-error');
    });

    form?.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      if ((target as HTMLInputElement).name === 'services') clearError('services-error');
      if (target.id === 'budget-range') clearError('budget-error');
      if (target.id === 'timeline') clearError('timeline-error');
    });
  });
</script>

<style>
  /* ============================================================
     CONTAINER
     ============================================================ */
  .container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ============================================================
     HERO — Gradient background, distinct from Contact's flat navy
     ============================================================ */
  .project-hero {
    background: linear-gradient(160deg, #003350 0%, #004466 40%, #006DCC 100%);
    color: var(--color-white);
    padding: 100px 0 80px;
    text-align: center;
